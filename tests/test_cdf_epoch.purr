# space.time — NASA CDF_EPOCH bridge (milliseconds since year 0). Ties space.time to space.cdf.
import io
import space.time as st
import check

io.print("== space.time: CDF_EPOCH ==")
let f = 0

# the bridging constant
f += check.close_eq("offset ms", st.cdf_epoch_unix_offset_ms(), 62167219200000.0)

# Unix epoch <-> CDF_EPOCH (exact integers, < 2^53)
f += check.close_eq("unix 0 -> cdf", st.unix_to_cdf_epoch(0.0), 62167219200000.0)
f += check.close_eq("cdf -> unix 0", st.cdf_epoch_to_unix(62167219200000.0), 0.0)

# J2000 (2000-01-01T12:00:00Z) has the well-known CDF_EPOCH 63113947200000.0
f += check.close_eq("J2000 unix -> cdf", st.unix_to_cdf_epoch(946728000.0), 63113947200000.0)
f += check.close_eq("cdf -> J2000 unix", st.cdf_epoch_to_unix(63113947200000.0), 946728000.0)

# one second is 1000 CDF_EPOCH ms (subtracting the ~6.2e13 offset costs ~0.02 ms of precision)
f += check.near_eq("one second", st.unix_to_cdf_epoch(1.0) - st.cdf_epoch_unix_offset_ms(), 1000.0, 0.1)

# round trips (absolute 1 ms tol — the large CDF_EPOCH offset limits double precision)
let ts = [0.0, 1.0, 946728000.0, 1700000000.0]
for s in ts {
    f += check.near_eq("unix->cdf->unix", st.cdf_epoch_to_unix(st.unix_to_cdf_epoch(s)), s, 0.001)
}

check.result(f)
